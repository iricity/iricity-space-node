{
  "name": "@iricity/space-node",
  "version": "0.5.0",
  "description": "Reference node of the Frontier State Protocol: a did:key identity, self-declared authorizations, signed pass predictions and signed observations, with an append-only receipt chain anyone can verify offline.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/app.js",
  "exports": {
    ".": "./src/app.js",
    "./app": "./src/app.js",
    "./agent": "./src/agent.js",
    "./identity": "./src/identity.js",
    "./node": "./src/node.js",
    "./descriptor": "./src/descriptor.js",
    "./orbital": "./src/orbital/propagation.js",
    "./connectors/celestrak": "./src/connectors/celestrak.js",
    "./connectors/satnogs": "./src/connectors/satnogs.js",
    "./store": "./src/store/nodeStore.js",
    "./database": "./src/store/database.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs/openapi.yaml",
    "docs/*.md",
    "examples",
    "scripts",
    "node.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1",
    "lint:openapi": "redocly lint docs/openapi.yaml",
    "keygen": "node scripts/keygen.mjs",
    "demo:two-nodes": "node examples/two-nodes.mjs"
  },
  "dependencies": {
    "@iricity/frontier-shared": "^0.5.0",
    "fastify": "^5.2.1",
    "satellite.js": "^7.1.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@redocly/cli": "^1.27.1"
  },
  "keywords": [
    "space",
    "satellite-tracking",
    "sgp4",
    "satnogs",
    "did-key",
    "ed25519",
    "verifiable-data",
    "fastify",
    "frontier-state-protocol"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iricity/iricity-space-node.git"
  },
  "homepage": "https://github.com/iricity/iricity-space-node#readme",
  "bugs": {
    "url": "https://github.com/iricity/iricity-space-node/issues"
  },
  "bin": {
    "space-node": "src/server.js",
    "space-node-keygen": "scripts/keygen.mjs"
  }
}
