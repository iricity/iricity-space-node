{
  "name": "@iricity/space-node",
  "version": "0.1.0",
  "description": "Reference node of the Frontier State Protocol: a did:key identity, self-declared authorizations, signed pass predictions and signed observations, with an append-only receipt chain anyone can verify offline.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1",
    "lint:openapi": "redocly lint docs/openapi.yaml",
    "keygen": "node scripts/keygen.mjs"
  },
  "dependencies": {
    "@iricity/frontier-shared": "file:vendor/iricity-frontier-shared-0.3.0.tgz",
    "fastify": "^5.2.1",
    "satellite.js": "^7.1.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@redocly/cli": "^1.27.1"
  }
}
