# Copy to .env (or export in your process manager). Nothing here is required to try
# the node; everything is required before you publish objects other people rely on.

# Who this node is. Either point at a manifest file (see node.example.json) ...
NODE_MANIFEST_PATH=node.json
# ... or set the fields directly; these override the manifest when present.
# NODE_ID=node_example
# NODE_NAME=Example ground node
# NODE_OPERATOR=Example Operator
# NODE_JURISDICTION=IN
# NODE_SITE_LATITUDE=28.6139
# NODE_SITE_LONGITUDE=77.209
# NODE_SITE_ALTITUDE_M=216

# Durable identity: ed25519 PKCS#8 PEM or a 64-hex seed. Generate with `npm run keygen`.
# Without it the node runs on an ephemeral key and says so on every surface.
# Required when NODE_ENV=production.
# NODE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
NODE_SIGNING_KEY_LABEL=node_key_v1

# Operator key for the write routes (record observations, metered passes). Any long
# random string. Without it the write routes answer 503.
# NODE_OPERATOR_KEY=

# Where the SQLite file lives.
NODE_DATA_DIR=data

PORT=3100
HOST=0.0.0.0

# Upstream data sources and their protection.
CELESTRAK_GP_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
SATNOGS_API_BASE_URL=https://network.satnogs.org/api
CONNECTOR_TIMEOUT_MS=8000
ELEMENTS_CACHE_TTL_MS=3600000
ELEMENTS_NEGATIVE_CACHE_TTL_MS=300000
DEFAULT_NORAD_CAT_ID=25544

# Per-client limit on keyless compute routes.
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX_REQUESTS=30
